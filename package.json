{
  "name": "couple-desktop-pet",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.16.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b --pretty false",
    "test": "vitest run",
    "test:watch": "vitest",
    "server:dev": "pnpm --dir server dev",
    "server:dev:lan": "pnpm --dir server dev:lan",
    "server:test": "pnpm --dir server test",
    "server:typecheck": "pnpm --dir server typecheck",
    "server:build": "pnpm --dir server build",
    "platform-api:dev": "pnpm --dir platform-api dev",
    "platform-api:test": "pnpm --dir platform-api test",
    "platform-api:typecheck": "pnpm --dir platform-api typecheck",
    "platform-api:build": "pnpm --dir platform-api build",
    "platform-web:dev": "pnpm --dir platform-web dev",
    "platform-web:test": "pnpm --dir platform-web test",
    "platform-web:typecheck": "pnpm --dir platform-web typecheck",
    "platform-web:build": "pnpm --dir platform-web build",
    "tauri:build:mac": "tauri build --target universal-apple-darwin --bundles app,dmg",
    "tauri:build:mac:qa": "tauri build --target universal-apple-darwin --bundles app,dmg --config src-tauri/tauri.macos.qa.conf.json",
    "macos:qa-build": "node scripts/macos/qa-build.mjs --mode qa",
    "macos:formal-build": "node scripts/macos/qa-build.mjs --mode formal",
    "macos:native-evidence": "node scripts/macos/native-evidence.mjs",
    "e2e:macos:build": "cross-env VITE_TAURI_E2E=1 tauri build --target universal-apple-darwin --bundles app --features e2e --config src-tauri/tauri.e2e.conf.json",
    "e2e:macos": "wdio run e2e/macos/wdio.conf.ts",
    "e2e:windows:build": "cross-env VITE_TAURI_E2E=1 tauri build --no-bundle --features e2e --config src-tauri/tauri.e2e.conf.json",
    "e2e:interop:windows": "wdio run e2e/interop/wdio.windows.conf.ts --suite interop",
    "e2e:interop:windows:restart": "wdio run e2e/interop/wdio.windows.conf.ts --suite restart",
    "e2e:interop:macos": "wdio run e2e/interop/wdio.macos.conf.ts --suite interop",
    "e2e:interop:macos:restart": "wdio run e2e/interop/wdio.macos.conf.ts --suite restart",
    "interop:rendezvous:create": "node scripts/interop/github-rendezvous.mjs create",
    "interop:rendezvous:cleanup": "node scripts/interop/github-rendezvous.mjs cleanup",
    "interop:validate": "node scripts/interop/cross-platform-smoke.mjs validate",
    "tauri": "tauri"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/plugin-dialog": "2.7.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@testing-library/react": "^16.3.2",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "@wdio/cli": "^9.30.1",
    "@wdio/globals": "^9.29.1",
    "@wdio/local-runner": "^9.30.1",
    "@wdio/mocha-framework": "^9.30.1",
    "@wdio/spec-reporter": "^9.30.1",
    "@wdio/tauri-plugin": "1.3.0",
    "@wdio/tauri-service": "1.3.0",
    "@wdio/types": "^9.30.1",
    "cross-env": "^10.1.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "yaml": "^2.9.0"
  }
}
