{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "情侣桌宠",
  "version": "0.1.0",
  "identifier": "com.couple-desktop-pet.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "情侣桌宠",
        "width": 320,
        "height": 360,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": false,
    "targets": "all"
  }
}
