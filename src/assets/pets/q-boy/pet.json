    "motion-message-pair": {
      "fps": 8,
      "loop": true,
      "frameCount": 48,
      "durationMs": 6000,
      "frames": "motions/motion-message-pair/",
      "weight": 1,
      "tags": [
        "message",
        "pair",
        "interaction"
      ]
    }
  }
}