{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "rootDir": "..",
    "outDir": "dist",
    "types": ["node", "vitest"],
    "noUncheckedIndexedAccess": true
  },
  "include": ["src/**/*.ts", "../shared/syncProtocol.ts"]
}
